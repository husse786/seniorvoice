# SeniorVoice — Environment Configuration (pipeline/)
# Copy this file to .env and change only what you need. .env is gitignored.
# Every value below is the default: the pipeline runs without any .env file.
# Names match pipeline/config.py.

# -------------------------------------------------------------------
# LLM — local only (decision A1, 14.11.2026)
# -------------------------------------------------------------------
# Local Ollama on this device. FS26 used a tuned Modelfile "gemma3:1b-prod".
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_MODEL=gemma3:1b
LLM_TIMEOUT=60
LLM_STREAM=false
# "default" = the values above. A chain like "a,b" reads LLM_A_* / LLM_B_*.
LLM_BACKENDS=default
# Backends outside this device are refused unless this is true.
# NEVER set this on a device used by seniors (conversation data would leave it).
ALLOW_CLOUD_LLM=false

# -------------------------------------------------------------------
# Memory (decision A8)
# -------------------------------------------------------------------
# Notes about the senior, kept at most 7 days (values above 7 are capped).
# No health data from conversations. "Vergiss das" / "Vergiss alles" by voice.
MEMORY_EXTRACTION_ENABLED=true
MEMORY_RETENTION_DAYS=7
MEMORY_PURGE_INTERVAL=3600
MEMORY_MAX_TURNS=10
MEMORY_TIMEOUT=300
# MEMORY_DB_PATH=~/seniorvoice/seniorvoice.db
# Technical metrics (timings, error codes) in their own file; Grafana and the
# health view read only this one. Default: next to MEMORY_DB_PATH.
# METRICS_DB_PATH=~/seniorvoice/metrics.db

# -------------------------------------------------------------------
# Logging (decision A8: no conversation text in log files)
# -------------------------------------------------------------------
LOG_LEVEL=INFO
# Development only: show conversation text on the console (never in files).
LOG_CONTENT=false
# LOG_DIR=~/seniorvoice/logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# -------------------------------------------------------------------
# Audio, STT, TTS
# -------------------------------------------------------------------
# Part of the microphone's name; empty = the system's default microphone (Mac)
AUDIO_DEVICE_NAME=C920
AUDIO_SAMPLE_RATE=16000
SILENCE_THRESHOLD=0.02
SILENCE_DURATION=2.0
MAX_RECORD_SECONDS=15
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=de
# PIPER_VOICE=~/.local/share/piper-voices/de_DE-thorsten-medium.onnx
SOUND_ENABLED=true
# Spoken answers are written here and deleted after playback. Default: /dev/shm/seniorvoice (RAM)
# OUTPUT_DIR=/dev/shm/seniorvoice

# -------------------------------------------------------------------
# PIR sensor (FS26 trigger; replaced by the handset hook switch later)
# -------------------------------------------------------------------
PIR_GPIO_PIN=4
PIR_GPIO_CHIP=4

# -------------------------------------------------------------------
# Help and Family channel (A4). Decided F4 (19.11.2026): e-mail.
# -------------------------------------------------------------------
# console = test channel without internet (default, simulation: shown on the
# phone page); email = real e-mails (docs/email-kanal.md); telegram = kept, unused
CHANNEL=console
# A mailbox only for this device (proposal: Infomaniak, CH). Port 587 = STARTTLS,
# 465 = TLS; IMAP 993 = TLS. Contacts confirm by replying to the Help mail.
# MAIL_SMTP_HOST=mail.infomaniak.com
# MAIL_SMTP_PORT=587
# MAIL_IMAP_HOST=mail.infomaniak.com
# MAIL_IMAP_PORT=993
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=
# TELEGRAM_BOT_TOKEN=
# How the device names the senior: in the greeting on pickup and in the
# Help message to contacts, e.g. "Frau Keller"
# SENIOR_NAME=
# The device opens each call itself (time of day, name, today's next
# appointment, a small question). Texts: pipeline/prompts/begruessung.txt
# GREETING_ON_PICKUP=true
# Folder with persona.txt and begruessung.txt (default: pipeline/prompts)
# PROMPTS_DIR=

# -------------------------------------------------------------------
# Telephone hardware (PR 7). Run: python core_service.py --input gpio
# -------------------------------------------------------------------
# Pi 5: 4 on older kernels, 0 on newer Raspberry Pi OS (check: gpiodetect)
GPIO_CHIP=4
# Hook switch NC to GND, internal pull-up: off-hook = HIGH (FS26 how-to)
HOOK_GPIO_PIN=17
HOOK_OFFHOOK_LEVEL=1
# Buttons to GND, internal pull-up (proposal, adapt to the wiring)
BUTTON_PINS=sprechen:5,heute:6,kalender:13,rat:19,familie:26,hilfe:21
# Setup guide: docs/inbetriebnahme-telefon.md
# Microphone of the handset (USB audio adapter), unique substring of the device name
# Values with spaces in quotes (works for systemd and for the shell)
# AUDIO_DEVICE_NAME="USB Audio"
# ALSA outputs: the Pi 5 has no headphone jack, so two USB audio adapters,
# named "handset" and "speaker" by a udev rule (see the guide) (A9, A13)
# HANDSET_ALSA_DEVICE=plughw:CARD=handset,DEV=0
# SPEAKER_ALSA_DEVICE=plughw:CARD=speaker,DEV=0

# -------------------------------------------------------------------
# Device API for the portal (PR 10, B4). Setup: docs/geraete-api.md
# -------------------------------------------------------------------
# Tunnel address only (WireGuard, docs/wireguard.md); 0.0.0.0 is refused.
# Default: local only (simulation on one computer). On the Pi: 10.77.0.2
DEVICE_API_HOST=127.0.0.1
DEVICE_API_PORT=8770
# From: python device_api_cli.py token (without it the API does not start)
# DEVICE_API_TOKEN_SHA256=
# Access log on the device, decided 30 days (T9)
AUDIT_RETENTION_DAYS=30

# -------------------------------------------------------------------
# Simulated telephone (docs/simulation.md). Run: scripts/start-simulation.sh
# -------------------------------------------------------------------
# text = type what the senior says, answers shown as text (no mic/speaker);
# audio = microphone and speaker as on the device
SIM_AUDIO=audio
# Page of the simulated phone, only on this computer: http://127.0.0.1:8771
SIM_PHONE_PORT=8771
# On a Pi without the telephone wired: its WireGuard address (10.77.0.2), so
# the team laptop opens the page through the tunnel. Never 0.0.0.0.
# SIM_PHONE_HOST=127.0.0.1
# Input when started by systemd (deploy/seniorvoice.service): gpio = the
# telephone, web = simulated phone page (Pi before the telephone is wired)
# SENIORVOICE_INPUT=gpio
