# SeniorVoice screen (T11): the device's screen page full-screen on the
# Touch Display 2, without a desktop (Raspberry Pi OS Lite + cage).
# Install: scripts/pi-einrichten.sh (replaces user "pi" and the paths).
# Needs: sudo apt install cage chromium wlr-randr
# Shows only http://127.0.0.1:8772 (local, read-only, no input).

[Unit]
Description=SeniorVoice screen (kiosk)
After=systemd-user-sessions.service seniorvoice.service
Wants=seniorvoice.service
# cage takes over the first console
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=pi
PAMName=login
SupplementaryGroups=video render input
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/home/pi/seniorvoice/.env
ExecStart=/usr/bin/cage -s -- /home/pi/seniorvoice/scripts/bildschirm-kiosk.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
