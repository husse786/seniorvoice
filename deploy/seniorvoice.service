# SeniorVoice telephone: core process (starts and supervises the dialog process).
# Install (see README, section "Autostart"):
#   sudo cp deploy/seniorvoice.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now seniorvoice
# Adjust User and paths if the device does not use user "pi" and ~/seniorvoice.

[Unit]
Description=SeniorVoice telephone (core + dialog)
After=network-online.target sound.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=pi
SupplementaryGroups=gpio audio
WorkingDirectory=/home/pi/seniorvoice/pipeline
EnvironmentFile=-/home/pi/seniorvoice/.env
# piper is installed into the virtualenv and found via PATH
Environment=PATH=/home/pi/seniorvoice/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pi/seniorvoice/.venv/bin/python core_service.py --input gpio
Restart=always
RestartSec=5
# Logs go to the journal; conversation text is never logged (A8)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
